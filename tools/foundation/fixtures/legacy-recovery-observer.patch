+package com.drivedeck.player.spike;
+import java.lang.reflect.Field;
+import java.nio.file.*;
+/** Historical experiment only: read the original gate's fields without editing its bytecode. */
+final class LegacyDecisionObserver {
+ private final NetworkScenario target;
+ private final Field resumed,steady,position,audio,pictures,painted;
+ LegacyDecisionObserver(NetworkScenario target) throws Exception {
+  this.target=target;
+  resumed=field("resumed");steady=field("steadySeconds");position=field("referencePosition");audio=field("referenceAudio");pictures=field("referencePictures");painted=field("referencePainted");
+ }
+ private Field field(String name) throws Exception {var f=NetworkScenario.class.getDeclaredField(name);f.setAccessible(true);return f;}
+ long[] snapshot() throws Exception {return new long[]{resumed.getBoolean(target)?1:0,position.getLong(target),audio.getLong(target),pictures.getLong(target),painted.getLong(target),steady.getInt(target)};}
+ void after(long[] before,long elapsed) throws Exception {
+  if(before[0]==0 || steady.getInt(target)!=0) return;
+  var now=snapshot();var file=Path.of(System.getenv("DD_PLAYER_PRESENTATION_DIR"),"original-gate-failures.csv");
+  if(!Files.exists(file)) Files.writeString(file,"epochMs,elapsedMs,clockDelta,audioDelta,pictureDelta,paintDeltaAtReference,priorSteady\n");
+  Files.writeString(file,System.currentTimeMillis()+","+elapsed+","+(now[1]-before[1])+","+(now[2]-before[2])+","+(now[3]-before[3])+","+(now[4]-before[4])+","+before[5]+"\n",StandardOpenOption.APPEND);
+ }
+}
